# ══════════════════════════════════════════════════════════════════════
#  Happy Humans — Variables d'environnement
#
#  Développement : copier ce fichier en .env.local et remplir les valeurs.
#  Production    : Vercel → Project → Settings → Environment Variables.
#
#  ⚠️ Le dépôt GitHub est PUBLIC : ne jamais commiter .env.local ni coller une
#     clé dans le code. Les clés « service_role », « ACCESS_TOKEN » et « API_KEY »
#     donnent un accès complet : elles ne vont QUE dans Vercel / .env.local.
#
#  Pas de compte Supabase sous la main ?  →  npm run dev:mock  (faux Supabase local)
# ══════════════════════════════════════════════════════════════════════

# ══ OBLIGATOIRES ══════════════════════════════════════════════════════

# ── Supabase ─────────────────────────────────────────────────────────
# Supabase → Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...          # clé publique (anon / public)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...              # clé privée (service_role) — NE PAS exposer !

# ── Admin du CMS (/cms-admin) ────────────────────────────────────────
CMS_PASSWORD=choisir-un-mot-de-passe-fort
# Secret qui signe la session de l'admin. Sans lui, le mot de passe sert de secret : à éviter.
CMS_SESSION_SECRET=une-chaine-aleatoire-longue-et-unique
# Secret qui signe le lien « Éditer le site » et la session d'édition en ligne (2 h).
# Sans lui : CMS_SESSION_SECRET est utilisé. Idéalement une valeur distincte.
CMS_HMAC_SECRET=une-autre-chaine-aleatoire-longue

# ══ RECOMMANDÉES ══════════════════════════════════════════════════════

# ── Adresse publique du site ─────────────────────────────────────────
# Base des URL canoniques, du sitemap, de robots.txt, des articles et des e-mails.
# Adresse officielle : https://happyhumans.vercel.app (c'est aussi la valeur par défaut : variable facultative).
# À ne changer que si un nom de domaine personnalisé est branché un jour. Sans slash final.
NEXT_PUBLIC_SITE_URL=https://happyhumans.vercel.app

# ── E-mails (Brevo) : confirmations de contact / réservation + notification à Monica ──
# https://app.brevo.com → SMTP & API
BREVO_API_KEY=xkeysib-xxxx
SENDER_EMAIL=happyhumans.coaching@gmail.com        # expéditeur (doit être validé chez Brevo)
SENDER_NAME=Happy Humans
ADMIN_EMAIL=happyhumans.coaching@gmail.com         # reçoit les demandes de contact / réservation

# ══ OPTIONNELLES ══════════════════════════════════════════════════════

# ── Statistiques Google Search Console (onglet « 📊 Statistiques Google ») ──
# Sans ces deux variables, l'onglet explique simplement comment les installer : rien ne casse.
# Google Cloud → IAM → Comptes de service → créer → clé JSON, puis ajouter l'adresse
# du compte de service comme utilisateur (lecture) de la propriété dans Search Console.
GSC_SERVICE_ACCOUNT_EMAIL=<redacted>
# Clé privée de la clé JSON. Sur une seule ligne avec des « \n » littéraux (format Vercel).
GSC_SERVICE_ACCOUNT_PRIVATE_KEY=<redacted>

# ── IA de l'admin (questionnaires, articles de blog, carrousels) ─────
# Un seul fournisseur suffit ; le premier configuré est utilisé, dans cet ordre (lib/ai-text.ts) :
# (Ces clés peuvent aussi se saisir dans l'admin → onglet « 🤖 IA », sans passer par Vercel : elles y sont chiffrées.
#  Une valeur définie ici l'emporte toujours sur celle de l'admin.)
# 1. Claude — payant, meilleure qualité            https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# 2. Cloudflare Workers AI — gratuit (quota quotidien)  https://dash.cloudflare.com → Workers AI
#    Jeton avec la permission « Workers AI » ; l'Account ID est dans l'URL du tableau de bord.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# 3. Groq — gratuit                                https://console.groq.com
GROQ_API_KEY=
# 4. Google Gemini — gratuit (quota quotidien)     https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash                    (facultatif : changer de modèle sans toucher au code)
# AI_PROVIDER=gemini                               (facultatif : forcer un fournisseur plutôt que « le premier configuré »)
# Photos proposées avec les carrousels (facultatif)  https://unsplash.com/developers
NEXT_PUBLIC_UNSPLASH_ACCESS_KEY=xxxx

# ── Instagram (publication depuis l'admin + flux sur le site) ────────
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_USERNAME=
BEHOLD_API_KEY=

# ── Newsletter ───────────────────────────────────────────────────────
# /api/brevo/subscribe et /api/newsletter : Brevo (BREVO_API_KEY ci-dessus).
# /api/newsletter lit en plus RESEND_API_KEY (service historique).
RESEND_API_KEY=re_xxxx

# ══ ANCIEN CODE / DÉVELOPPEMENT LOCAL SEULEMENT ═══════════════════════
# OLLAMA_URL=http://localhost:11434                # /api/ai/generate : modèle local (inutile en production)
# OLLAMA_MODEL=llama3
# MONGODB_URI=                                     # lib/db.ts et lib/mongodb.ts : code mort, jamais importé
# SUPABASE_ANON_KEY= / SUPABASE_SERVICE_KEY=       # alias lus uniquement par /api/seed-articles
